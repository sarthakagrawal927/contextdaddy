{
  "name": "storagedaddy",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "significanthobbies.com/storagedaddy",
      "zone_name": "significanthobbies.com"
    },
    {
      "pattern": "significanthobbies.com/storagedaddy/*",
      "zone_name": "significanthobbies.com"
    },
    {
      "pattern": "storagedaddy.significanthobbies.com",
      "custom_domain": true
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "DOWNLOADS",
      "dataset": "storagedaddy_launch"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
